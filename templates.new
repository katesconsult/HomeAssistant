# Family room shades
- cover:
  - name: Family Room Shades
    unique_id: mock_shade_family_room
    set_cover_position:
    - data:
        value: '{{ position }}'
      target:
        entity_id:
        - input_number.family_room_shade_position
      action: input_number.set_value
    open_cover:
    - data:
        value: 100
      target:
        entity_id:
        - input_number.family_room_shade_position
      service: script.family_room_shades_open
    close_cover:
    - data:
        value: 0
      target:
        entity_id:
        - input_number.family_room_shade_position
      service: script.family_room_shades_close
    stop_cover:
    - data:
        value: '{{ states(''input_number.family_room_shade_position'') }}'
      target:
        entity_id:
        - input_number.family_room_shade_position
      action: input_number.set_value
    position: '{{ states(''input_number.family_room_shade_position'') | int }}'

